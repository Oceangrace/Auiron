        "format": "uint32",
        "minimum": 1,
        "type": "integer"
      },
      "maxItems": 100000,
      "minItems": 1,
      "type": "array"
    },
    "schemaVersion": {
      "format": "uint32",
      "maximum": 1,
      "minimum": 1,
      "type": "integer"
    }
  },
  "required": ["schemaVersion", "clientBuild", "catalogVersion", "npcIds"],
  "title": "NpcCatalog",
  "type": "object"
}

{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2023", "ESNext.Disposable", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "resolveJsonModule": true,
    "composite": true,
    "tsBuildInfoFile": "node_modules/.cache/app.tsbuildinfo"
  },
  "include": ["src/**/*.ts", "src/**/*.vue"],
  "exclude": ["node_modules", "dist", "src-tauri"]
}
